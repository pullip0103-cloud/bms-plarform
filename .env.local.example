# Firebase 클라이언트 설정값 (Firebase Console > 프로젝트 설정 > 일반 > 내 앱 에서 확인)
# Firestore + Authentication만 사용한다 (사진은 Cloudinary에 저장 — Storage 불필요).
NEXT_PUBLIC_FIREBASE_API_KEY=xxxxxxxx
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=xxxxxxxx.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=xxxxxxxx

# Firebase Admin SDK 서비스 계정 (Firebase Console > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성)
# ⚠️ 비밀 키입니다. 절대 git에 커밋하지 마세요.
FIREBASE_PROJECT_ID=xxxxxxxx
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@xxxxxxxx.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Cloudinary (사진 저장/업로드, 무료 플랜 — 결제 계정 등록 불필요)
# Cloudinary Console > Dashboard 에서 확인
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=xxxxxxxx
CLOUDINARY_CLOUD_NAME=xxxxxxxx
CLOUDINARY_API_KEY=xxxxxxxx
CLOUDINARY_API_SECRET=xxxxxxxx
